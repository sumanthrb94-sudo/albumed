# The album assistant runs server-side. Without a key the app still works —
# uploads, review, templates, layout and PDF export — the AI features are just off.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# ALBUMED_MODEL=claude-opus-5        # the model the assistant uses
# ALBUMED_DEMO_AI=0                  # without a key the assistant returns scripted
#                                    # replies so a demo still works, clearly labelled
#                                    # in the UI. Set 0 to switch it off entirely.
# ALBUMED_CURATE_BATCH=6             # photos per vision request
# PORT=8787
# HOST=0.0.0.0
# ALBUMED_RATE_LIMIT=60              # requests per window, per client, per route
# ALBUMED_RATE_WINDOW_MS=60000
# ALBUMED_MAX_BODY=25165824          # 24 MB
# ANTHROPIC_BASE_URL=                # point at a mock or a proxy

# Plans and their limits live in src/lib/plan.ts, not here — they are product
# decisions the client enforces, and payments are not wired up yet.
